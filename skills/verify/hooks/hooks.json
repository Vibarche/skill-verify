{
  "_comment": "Plugin-style hooks configuration. Merge into the consuming project's Claude Code hooks configuration; do not assume that copying this file alone activates hooks.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/verify/hooks/post-task.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/skills/verify/hooks/post-task.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
